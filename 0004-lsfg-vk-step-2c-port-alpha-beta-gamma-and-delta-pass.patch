diff --git a/src/video_core/renderer_vulkan/lsfg/lsfg_alpha.cpp b/src/video_core/renderer_vulkan/lsfg/lsfg_alpha.cpp
new file mode 100644
index 0000000..2dbb917
--- /dev/null
+++ b/src/video_core/renderer_vulkan/lsfg/lsfg_alpha.cpp
@@ -0,0 +1,137 @@
+// Copyright 2026 Eden Emulator Project / lsfg-vk (2025)
+// Adapted for Azahar Plus. Licensed under GPLv3 or any later version.
+
+#include <vector>
+
+#include "video_core/frame_gen/lossless_dll.h"
+#include "video_core/renderer_vulkan/lsfg/lsfg_alpha.h"
+#include "video_core/renderer_vulkan/lsfg/lsfg_shaders.h"
+#include "video_core/renderer_vulkan/vk_instance.h"
+
+namespace Vulkan {
+
+namespace {
+
+constexpr u32 DISPATCH_TILE_SHIFT = 3;
+
+[[nodiscard]] u32 GroupCount(u32 size) {
+    return (size + (1u << DISPATCH_TILE_SHIFT) - 1) >> DISPATCH_TILE_SHIFT;
+}
+
+[[nodiscard]] vk::Extent2D HalveExtent(vk::Extent2D extent) {
+    return vk::Extent2D{
+        .width = (extent.width + 1) >> 1,
+        .height = (extent.height + 1) >> 1,
+    };
+}
+
+} // Anonymous namespace
+
+LsfgAlphaPasses::LsfgAlphaPasses(const Instance& instance, const LsfgShaders& shaders) {
+    using namespace VideoCore::FrameGen::PerformanceShader;
+
+    passes[0] = LsfgPass(instance, shaders, ALPHA[0],
+                         {{1, vk::DescriptorType::eSampler},
+                          {1, vk::DescriptorType::eSampledImage},
+                          {1, vk::DescriptorType::eStorageImage}});
+    passes[1] = LsfgPass(instance, shaders, ALPHA[1],
+                         {{1, vk::DescriptorType::eSampler},
+                          {1, vk::DescriptorType::eSampledImage},
+                          {1, vk::DescriptorType::eStorageImage}});
+    passes[2] = LsfgPass(instance, shaders, ALPHA[2],
+                         {{1, vk::DescriptorType::eSampler},
+                          {1, vk::DescriptorType::eSampledImage},
+                          {2, vk::DescriptorType::eStorageImage}});
+    passes[3] = LsfgPass(instance, shaders, ALPHA[3],
+                         {{1, vk::DescriptorType::eSampler},
+                          {2, vk::DescriptorType::eSampledImage},
+                          {2, vk::DescriptorType::eStorageImage}});
+}
+
+LsfgAlpha::LsfgAlpha(const Instance& instance,
+                     const LsfgAlphaPasses& passes_, LsfgResources& resources,
+                     vk::DescriptorPool descriptor_pool, LsfgImage& input_)
+    : passes{&passes_}, input{&input_} {
+    const vk::Extent2D half_extent = HalveExtent(input->Extent());
+    const vk::Extent2D quarter_extent = HalveExtent(half_extent);
+
+    temp1 = LsfgImage(instance, half_extent);
+    temp2 = LsfgImage(instance, half_extent);
+    for (size_t i = 0; i < temp3.size(); ++i) {
+        temp3[i] = LsfgImage(instance, quarter_extent);
+        for (size_t j = 0; j < LSFG_HISTORY_SLOTS; ++j) {
+            out_images[j][i] = LsfgImage(instance, quarter_extent);
+        }
+    }
+
+    std::vector<vk::DescriptorSetLayout> layouts;
+    for (size_t i = 0; i < LSFG_ALPHA_STAGES - 1; ++i) {
+        layouts.push_back(passes->Get(i).SetLayout());
+    }
+    for (size_t i = 0; i < LSFG_HISTORY_SLOTS; ++i) {
+        layouts.push_back(passes->Get(3).SetLayout());
+    }
+    const std::vector<vk::DescriptorSet> owned_sets =
+        AllocateLsfgDescriptorSets(instance, descriptor_pool, layouts);
+
+    for (size_t i = 0; i < LSFG_ALPHA_STAGES - 1; ++i) {
+        descriptor_sets[i] = owned_sets[i];
+    }
+    for (size_t i = 0; i < LSFG_HISTORY_SLOTS; ++i) {
+        last_descriptor_sets[i] = owned_sets[LSFG_ALPHA_STAGES - 1 + i];
+    }
+
+    const vk::Sampler sampler = resources.GetSampler();
+
+    LsfgDescriptorWriter(descriptor_sets[0])
+        .AddSampler(sampler)
+        .AddSampledImage(*input)
+        .AddStorageImage(temp1)
+        .Build(instance);
+    LsfgDescriptorWriter(descriptor_sets[1])
+        .AddSampler(sampler)
+        .AddSampledImage(temp1)
+        .AddStorageImage(temp2)
+        .Build(instance);
+    LsfgDescriptorWriter(descriptor_sets[2])
+        .AddSampler(sampler)
+        .AddSampledImage(temp2)
+        .AddStorageImages(temp3)
+        .Build(instance);
+    for (size_t i = 0; i < LSFG_HISTORY_SLOTS; ++i) {
+        LsfgDescriptorWriter(last_descriptor_sets[i])
+            .AddSampler(sampler)
+            .AddSampledImages(temp3)
+            .AddStorageImages(out_images[i])
+            .Build(instance);
+    }
+}
+
+void LsfgAlpha::PushBarriers(LsfgBarriers& barriers, u64 frame_count, size_t stage) {
+    switch (stage) {
+    case 0:
+        barriers.WriteToRead(*input).ReadToWrite(temp1);
+        break;
+    case 1:
+        barriers.WriteToRead(temp1).ReadToWrite(temp2);
+        break;
+    case 2:
+        barriers.WriteToRead(temp2).ReadToWriteAll(temp3);
+        break;
+    default:
+        barriers.WriteToReadAll(temp3).ReadToWriteAll(out_images[frame_count % LSFG_HISTORY_SLOTS]);
+        break;
+    }
+}
+
+void LsfgAlpha::DispatchStage(vk::CommandBuffer cmdbuf, u64 frame_count, size_t stage) {
+    const vk::Extent2D extent = stage < 2 ? temp1.Extent() : temp3[0].Extent();
+    const vk::DescriptorSet set = stage < LSFG_ALPHA_STAGES - 1
+                                    ? descriptor_sets[stage]
+                                    : last_descriptor_sets[frame_count % LSFG_HISTORY_SLOTS];
+
+    passes->Get(stage).BindSet(cmdbuf, set);
+    cmdbuf.dispatch(GroupCount(extent.width), GroupCount(extent.height), 1);
+}
+
+} // namespace Vulkan
