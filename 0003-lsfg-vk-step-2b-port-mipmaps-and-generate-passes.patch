+// Copyright 2026 Eden Emulator Project / lsfg-vk (2025)
+// Adapted for Azahar Plus. Licensed under GPLv3 or any later version.
+
+#pragma once
+
+#include <array>
+#include <vector>
+
+#include "common/common_types.h"
+#include "video_core/renderer_vulkan/lsfg/lsfg_common.h"
+
+namespace Vulkan {
+
+class Instance;
+class LsfgShaders;
+
+constexpr size_t LSFG_MIP_LEVELS = 7;
+
+/// Downsamples the (optionally flow-scaled) input frame into a chain of single-channel images.
+class LsfgMipmaps {
+public:
+    LsfgMipmaps() = default;
+    LsfgMipmaps(const Instance& instance, const LsfgShaders& shaders, LsfgResources& resources,
+                vk::DescriptorPool descriptor_pool, LsfgImagePair& frames, f32 flow_scale);
+
+    void Dispatch(vk::CommandBuffer cmdbuf, u64 frame_count);
+
+    [[nodiscard]] LsfgImage& Output(size_t level) {
+        return out_images[level];
+    }
+
+private:
+    LsfgImagePair* frames{};
+
+    LsfgPass pass;
+    std::array<vk::DescriptorSet, 2> descriptor_sets{};
+
+    vk::Extent2D flow_extent{};
+    std::array<LsfgImage, LSFG_MIP_LEVELS> out_images;
+};
+
+} // namespace Vulkan
