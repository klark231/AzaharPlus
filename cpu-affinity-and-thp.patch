+/// Current kernel policy for THP on shared memory (memfd/tmpfs), e.g. "always [advise] never".
+std::string ReadShmemThpPolicy() {
+    std::ifstream f("/sys/kernel/mm/transparent_hugepage/shmem_enabled");
+    std::string line;
+    if (!f || !std::getline(f, line)) {
+        return "unavailable";
