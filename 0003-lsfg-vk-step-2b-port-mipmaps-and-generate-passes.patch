diff --git a/src/video_core/renderer_vulkan/lsfg/lsfg_generate.cpp b/src/video_core/renderer_vulkan/lsfg/lsfg_generate.cpp
new file mode 100644
index 0000000..013ae7e
--- /dev/null
+++ b/src/video_core/renderer_vulkan/lsfg/lsfg_generate.cpp
@@ -0,0 +1,117 @@
+// Copyright 2026 Eden Emulator Project / lsfg-vk (2025)
+// Adapted for Azahar Plus. Licensed under GPLv3 or any later version.
+
+#include <vector>
+
+#include "video_core/frame_gen/lossless_dll.h"
+#include "video_core/renderer_vulkan/lsfg/lsfg_generate.h"
+#include "video_core/renderer_vulkan/lsfg/lsfg_shaders.h"
+#include "video_core/renderer_vulkan/vk_instance.h"
+
+namespace Vulkan {
+
+namespace {
+
+constexpr u32 DISPATCH_TILE_SHIFT = 4;
+
+[[nodiscard]] u32 GroupCount(u32 size) {
+    return (size + (1u << DISPATCH_TILE_SHIFT) - 1) >> DISPATCH_TILE_SHIFT;
+}
+
+} // Anonymous namespace
+
+LsfgGenerate::LsfgGenerate(const Instance& instance, const LsfgShaders& shaders,
+                           LsfgResources& resources, vk::DescriptorPool descriptor_pool,
+                           LsfgImagePair& frames_, LsfgImage& motion_, LsfgImage& detail1_,
+                           LsfgImage& detail2_)
+    : frames{&frames_}, motion{&motion_}, detail1{&detail1_}, detail2{&detail2_} {
+    using namespace VideoCore::FrameGen::PerformanceShader;
+
+    pass = LsfgPass(instance, shaders, GENERATE,
+                    {{1, vk::DescriptorType::eUniformBuffer},
+                     {2, vk::DescriptorType::eSampler},
+                     {5, vk::DescriptorType::eSampledImage},
+                     {1, vk::DescriptorType::eStorageImage}});
+
+    sampler = resources.GetSampler();
+    edge_sampler =
+        resources.GetSampler(vk::SamplerAddressMode::eClampToEdge, vk::CompareOp::eAlways, false);
+
+    const std::vector<vk::DescriptorSet> sets = AllocateLsfgDescriptorSets(
+        instance, descriptor_pool, pass.SetLayout(), LSFG_GENERATION_SLOTS * LSFG_MAX_TARGETS * 2);
+
+    size_t next = 0;
+    for (size_t slot = 0; slot < LSFG_GENERATION_SLOTS; ++slot) {
+        Generation& generation = generations[slot];
+        generation.buffer = resources.GetBuffer(LsfgSlotTimestamp(slot));
+
+        for (auto& entry : generation.targets) {
+            for (auto& set : entry.descriptor_sets) {
+                set = sets[next++];
+            }
+        }
+    }
+}
+
+void LsfgGenerate::SetTarget(const Instance& instance, size_t slot, u32 target,
+                             vk::ImageView view) {
+    Target& entry = generations[slot].targets[target];
+    if (entry.view == view) {
+        return;
+    }
+    entry.view = view;
+
+    for (size_t i = 0; i < entry.descriptor_sets.size(); ++i) {
+        LsfgDescriptorWriter(entry.descriptor_sets[i])
+            .AddUniformBuffer(generations[slot].buffer, LsfgResources::BufferSize())
+            .AddSampler(sampler)
+            .AddSampler(edge_sampler)
+            .AddSampledImage((*frames)[1 - i])
+            .AddSampledImage((*frames)[i])
+            .AddSampledImage(*motion)
+            .AddSampledImage(*detail1)
+            .AddSampledImage(*detail2)
+            .AddStorageView(view)
+            .Build(instance);
+    }
+}
+
+void LsfgGenerate::Dispatch(vk::CommandBuffer cmdbuf, u64 frame_count, size_t slot, u32 target,
+                            vk::Image image, vk::Extent2D extent) {
+    const Target& entry = generations[slot].targets[target];
+
+    LsfgBarriers(cmdbuf)
+        .WriteToReadAll(*frames)
+        .WriteToRead(*motion)
+        .WriteToRead(*detail1)
+        .WriteToRead(*detail2)
+        .DiscardToWrite(image)
+        .Build();
+
+    pass.Bind(cmdbuf, entry.descriptor_sets[frame_count % entry.descriptor_sets.size()]);
+    cmdbuf.dispatch(GroupCount(extent.width), GroupCount(extent.height), 1);
+
+    // Hand the finished frame to the present path. Unlike Eden (which keeps GENERAL), Azahar's
+    // PresentWindow blits/copies from TRANSFER_SRC_OPTIMAL.
+    const vk::ImageMemoryBarrier to_transfer_src = {
+        .srcAccessMask = vk::AccessFlagBits::eShaderWrite,
+        .dstAccessMask = vk::AccessFlagBits::eTransferRead,
+        .oldLayout = vk::ImageLayout::eGeneral,
+        .newLayout = vk::ImageLayout::eTransferSrcOptimal,
+        .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+        .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+        .image = image,
+        .subresourceRange =
+            {
+                .aspectMask = vk::ImageAspectFlagBits::eColor,
+                .baseMipLevel = 0,
+                .levelCount = 1,
+                .baseArrayLayer = 0,
+                .layerCount = 1,
+            },
+    };
+    cmdbuf.pipelineBarrier(vk::PipelineStageFlagBits::eComputeShader,
+                           vk::PipelineStageFlagBits::eTransfer, {}, {}, {}, to_transfer_src);
+}
+
+} // namespace Vulkan
