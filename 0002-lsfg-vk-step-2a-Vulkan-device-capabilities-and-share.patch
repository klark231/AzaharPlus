+// Copyright 2026 Eden Emulator Project / lsfg-vk (2025)
+// Adapted for Azahar Plus. Licensed under GPLv3 or any later version.
+
+#include "common/logging/log.h"
+#include "video_core/frame_gen/lossless_dll.h"
+#include "video_core/renderer_vulkan/lsfg/lsfg_shaders.h"
+#include "video_core/renderer_vulkan/vk_instance.h"
+
+namespace Vulkan {
+
+LsfgShaders::LsfgShaders(const Instance& instance) {
+    if (!instance.IsLsfgCapable()) {
+        LOG_WARNING(Render_Vulkan,
+                    "Frame generation unavailable: device lacks Vulkan memory model, native FP16, "
+                    "null descriptors or storage image write-without-format");
+        return;
+    }
+
+    VideoCore::FrameGen::ShaderModules code;
+    const auto status = VideoCore::FrameGen::LoadShaderModules(code);
+    if (status != VideoCore::FrameGen::LosslessStatus::Ok) {
+        LOG_WARNING(Render_Vulkan, "Frame generation unavailable: Lossless.dll status {}",
+                    static_cast<u32>(status));
+        return;
+    }
+
+    const vk::Device device = instance.GetDevice();
+    try {
+        for (const auto& [id, words] : code) {
+            const vk::ShaderModuleCreateInfo module_info = {
+                .codeSize = words.size() * sizeof(u32),
+                .pCode = words.data(),
+            };
+            modules.emplace(id, device.createShaderModuleUnique(module_info));
+        }
+    } catch (const vk::SystemError& err) {
+        LOG_ERROR(Render_Vulkan, "Failed to create frame generation shader modules: {}",
+                  err.what());
+        modules.clear();
+        return;
+    }
+    valid = true;
+}
+
+vk::ShaderModule LsfgShaders::Get(u32 shader_id) const {
+    const auto hit = modules.find(shader_id);
+    return hit == modules.end() ? vk::ShaderModule{} : *hit->second;
+}
+
+} // namespace Vulkan
